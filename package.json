{
  "name": "parallax-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-minded, cross-browser news framing and coverage analyzer.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build && npm run build:firefox",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "eval": "node evaluation/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@google/genai": "2.24.0",
    "@huggingface/transformers": "4.3.0",
    "@mozilla/readability": "0.6.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.103.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "dexie": "4.4.6",
    "fast-xml-parser": "5.11.1",
    "motion": "13.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.11.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  }
}
